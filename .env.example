DEEPSEEK_API_KEY=
# OpenAI key is intentionally restricted to embeddings in this project.
OPENAI_API_KEY=
OPENAI_EMBEDDINGS_ONLY=true
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# Z.ai general pay-as-you-go API token.
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# Z.ai GLM Coding Plan token. This is not interchangeable with ZAI_API_KEY.
ZAICODING_API_KEY=
ZAI_CODING_BASE_URL=https://api.z.ai/api/coding/paas/v4
MINDCRAFT_PROFILE=./profiles/deepseek.json
MINECRAFT_HOST=host.docker.internal
MINECRAFT_PORT=55916
MINDSERVER_PORT=8080
ALLOW_VISION=false
RENDER_BOT_VIEW=false
