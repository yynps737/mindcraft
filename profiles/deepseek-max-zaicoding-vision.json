{
    "name": "HybridZaiBot",
    "model": {
        "api": "deepseek",
        "model": "deepseek-v4-flash",
        "params": {
            "thinking": {
                "type": "disabled"
            },
            "stream": false
        }
    },
    "reasoning_model": {
        "api": "deepseek",
        "model": "deepseek-v4-pro",
        "params": {
            "thinking": {
                "type": "enabled"
            },
            "reasoning_effort": "max",
            "stream": false
        }
    },
    "code_model": {
        "api": "zaicoding",
        "model": "glm-5.2",
        "params": {
            "thinking": {
                "type": "enabled"
            },
            "reasoning_effort": "max",
            "stream": false
        }
    },
    "vision_model": {
        "api": "zaivisionmcp",
        "model": "glm-4.6v",
        "params": {
            "tool": "analyze_image",
            "timeout_ms": 120000
        }
    },
    "embedding": {
        "api": "openai",
        "model": "text-embedding-3-large"
    },
    "speak_model": "system",
    "cooldown": 2000
}
